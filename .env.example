# StackForge Supabase Configuration
# Replace these with your Supabase Project Settings -> API credentials
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Optional Code Execution Provider (e.g., Piston or isolate sandbox)
# When left empty, StackForge uses its built-in isolated web worker & sandboxed iframe execution engine
VITE_EXECUTION_API_URL=
